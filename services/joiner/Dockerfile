# ffmpeg needs a real filesystem and a real binary. Vercel functions and
# Cloudflare Workers have neither, which is the only reason this service
# exists — the joining itself is ordinary ffmpeg.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev
COPY server.js ./

ENV PORT=8080
EXPOSE 8080
CMD ["node", "server.js"]
