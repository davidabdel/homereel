# HomeReel — environment
#
# Copy to .env.local and fill in. .env.local is gitignored (verified) — put the
# real values there and nowhere else. Never paste a key into chat, a commit
# message, or a script.

# ---------------------------------------------------------------- demo mode
# Click through the whole app with no backend at all: auth bypassed, balance
# reads 1,000 credits, generating spends nothing. Remove for a real run.
NEXT_PUBLIC_DEMO=1


# --------------------------------------------------------------- generation
# The video + image models. Use a key created for HomeReel specifically, not a
# shared one — so spend is attributable and it can be revoked on its own.
KIE_API_KEY=
KIE_API_BASE=https://api.kie.ai
# Optional. Without it the app polls instead, which works but is chattier.
KIE_CALLBACK_URL=


# ------------------------------------------------------------ auth + database
# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The anon key is public by design and safe in the browser — RLS is what
# protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------- media storage
# Cloudflare R2. Worth doing regardless of the rest: R2 charges nothing for
# egress, and this product serves video.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=homereel-media
# The public bucket URL or custom domain, e.g. https://media.homereel.com.au
R2_PUBLIC_BASE_URL=


# -------------------------------------------------------------------- stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint, after it's created
STRIPE_WEBHOOK_SECRET=

# Price IDs. Leave blank and I'll create the products and fill these in, given
# a key with write access.
NEXT_PUBLIC_STRIPE_PRICE_MEMBERSHIP=
NEXT_PUBLIC_STRIPE_PRICE_TOPUP_20=
NEXT_PUBLIC_STRIPE_PRICE_TOPUP_50=
NEXT_PUBLIC_STRIPE_PRICE_TOPUP_100=


# ---------------------------------------------------------------------- site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
